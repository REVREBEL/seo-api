PORT=3000
SEO_API_KEY=replace-with-secure-key
NODE_ENV=development

DATABASE_URL=postgresql://seo_api_user:REPLACE_WITH_PASSWORD@localhost:5432/seo_api

SEO_API_BASE_URL=https://seo-api.revrebel.io

MCP_SERVER_PORT=3010
MCP_SHARED_SECRET=replace-with-optional-mcp-secret

CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_URLSCANNER_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_URLSCANNER_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_URLSCANNER_SCAN_PATH=/accounts/{accountId}/urlscanner/v2/scan
CLOUDFLARE_URLSCANNER_RESULT_PATH=/accounts/{accountId}/urlscanner/v2/result/{scanId}
CLOUDFLARE_URLSCANNER_POLL_INTERVAL_MS=3000
CLOUDFLARE_URLSCANNER_POLL_TIMEOUT_MS=60000

GEMINI_OAUTH_CLIENT_ID=seo-api-gemini-agent
GEMINI_OAUTH_CLIENT_SECRET=<generate-long-secret>
GEMINI_OAUTH_TOKEN_SECRET=<generate-another-long-secret>
GEMINI_OAUTH_ALLOWED_SCOPES="seo.audit seo.scan"
GEMINI_OAUTH_ALLOWED_REDIRECT_URIS=
GEMINI_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
GEMINI_OAUTH_CODE_TTL_SECONDS=300

# Clerk OAuth for the primary MCP endpoint.
# The resource URL must be the exact HTTPS MCP URL registered in Clerk and used by clients.
MCP_RESOURCE_URL=https://clerk.revrebel.io/mcp
CLERK_ISSUER=https://clerk.revrebel.io
CLERK_PUBLISHABLE_KEY=pk_live_replace-me
CLERK_SECRET_KEY=sk_live_replace-me
# Optional list advertised in protected-resource metadata. Existing tool authorization does not require these scopes.
MCP_OAUTH_SCOPES="profile email"
